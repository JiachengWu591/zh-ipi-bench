# Copy to .env. Never commit real values; the code only reads these names.
DEEPSEEK_API_KEY=
# Optional: judge model id; defaults to the one injection-blast-radius uses (unverified).
ZHIPI_JUDGE_MODEL=
# Hugging Face token, only needed for the gated Prompt Guard 2 repo.
HF_TOKEN=
# Path to a local checkout of injection-blast-radius (used by zhipi.adapters.ibr_adapter).
IBR_REPO=
